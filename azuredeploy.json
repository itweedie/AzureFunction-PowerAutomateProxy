{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
  "contentVersion": "1.0.0.0",
  "resources": [
    {
      "type": "Microsoft.Web/serverfarms",
      "apiVersion": "2022-03-01",
      "name": "[parameters('hostingPlanName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "[parameters('hostingPlanType')]",
        "tier": "[if(equals(parameters('hostingPlanType'), 'Y1'), 'Dynamic', 'ElasticPremium')]",
        "size": "[parameters('hostingPlanType')]",
        "family": "[if(equals(parameters('hostingPlanType'), 'Y1'), 'Y', 'EP')]",
        "capacity": 1
      },
      "kind": "functionapp"
    },
    {
      "type": "Microsoft.Storage/storageAccounts",
      "apiVersion": "2022-05-01",
      "name": "[parameters('storageAccountName')]",
      "location": "[parameters('location')]",
      "sku": {
        "name": "Standard_LRS" 
      },
      "kind": "StorageV2",
      "properties": {}
    },
    {
      "type": "Microsoft.Web/sites",
      "apiVersion": "2022-03-01",
      "name": "[parameters('functionAppName')]",
      "location": "[parameters('location')]",
      "kind": "functionapp",
      "properties": {
        "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]",
        "siteConfig": {
          "appSettings": [
            {
              "name": "AzureWebJobsStorage",
              "value": "[concat('DefaultEndpointsProtocol=https;AccountName=', parameters('storageAccountName'), ';AccountKey=', listKeys(resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName')), '2022-05-01').keys[0].value, ';EndpointSuffix=core.windows.net')]"
            },
            {
              "name": "FUNCTIONS_EXTENSION_VERSION",
              "value": "~4"
            },
            {
              "name": "FUNCTIONS_WORKER_RUNTIME",
              "value": "node"
            },
            {
              "name": "WEBSITE_NODE_DEFAULT_VERSION",
              "value": "~20"
            },
            {
              "name": "FLOW_KEY",
              "value": "[parameters('flowKey')]"
            },
            {
              "name": "FLOW_URL",
              "value": "[parameters('flowUrl')]"
            }
          ]
        }
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/serverfarms', parameters('hostingPlanName'))]",
        "[resourceId('Microsoft.Storage/storageAccounts', parameters('storageAccountName'))]"
      ]
    },
    {
      "type": "Microsoft.Web/sites/extensions",
      "apiVersion": "2022-03-01",
      "name": "[concat(parameters('functionAppName'), '/MSDeploy')]",
      "location": "[parameters('location')]",
      "properties": {
        "packageUri": "https://github.com/itweedie/AzureFunction-PowerAutomateProxy/releases/download/v3.0.8/function-app.zip"
      },
      "dependsOn": [
        "[resourceId('Microsoft.Web/sites', parameters('functionAppName'))]"
      ]
    }
  ],
  "parameters": {
    "location": {
      "type": "string",
"defaultValue": "UK South",
      "allowedValues": [
        "East US",
        "East US 2",
        "West US",
        "West US 2",
        "Central US",
        "North Central US",
        "South Central US",
        "West Europe",
        "North Europe",
        "Southeast Asia",
        "East Asia",
        "Japan East",
        "Japan West",
        "Australia East",
        "Australia Southeast",
        "Central India",
        "South India",
        "West India",
        "Canada Central",
        "Canada East",
        "UK South",
        "UK West",
        "West Central US",
        "Korea Central",
        "Korea South",
        "France Central",
        "France South",
        "Australia Central",
        "Australia Central 2",
        "UAE North",
        "UAE Central",
        "South Africa North",
        "South Africa West",
        "Switzerland North",
        "Switzerland West",
        "Germany North",
        "Germany West Central",
        "Norway East",
        "Norway West",
        "Brazil South",
        "Brazil Southeast"
      ],
      "metadata": {
        "description": "Location for all resources."
      }
    },
    "hostingPlanName": {
      "type": "string",
      "defaultValue": "my-consumption-plan",
      "metadata": {
        "description": "Name of the hosting plan."
      }
    },
    "hostingPlanType": {
      "type": "string",
      "allowedValues": [
        "Y1",          // Consumption Plan
        "EP1",         // Premium Plan EP1
        "EP2",         // Premium Plan EP2
        "EP3"          // Premium Plan EP3
      ],
      "defaultValue": "Y1",
      "metadata": {
        "description": "Type of the hosting plan."
      }
    },
    "functionAppName": {
      "type": "string",
      "defaultValue": "my-function-app",
      "metadata": {
        "description": "Name of the Azure Function App."
      }
    },
    "storageAccountName": {
      "type": "string",
      "defaultValue": "mystorageaccount",
      "metadata": {
        "description": "Name of the storage account."
      }
    },
    "flowKey": {
      "type": "string",
      "metadata": {
        "description": "The FLOW_KEY environment variable."
      }
    },
    "flowUrl": {
      "type": "string",
      "metadata": {
        "description": "The FLOW_URL environment variable."
      }
    }
  }
}
