{
    "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentTemplate.json#",
    "contentVersion": "1.0.0.0",
    "parameters": {
        "location": {
            "type": "string",
            "defaultValue": "UK South"
        },
        "functionNames": {
            "type": "array",
            "defaultValue": ["proxy", "Trigger", "Trigger2"]
        },
        "githubReleaseUrl": {
            "type": "string",
            "defaultValue": "https://github.com/owner/repo/releases/download/v1.0.0/artifact.zip"
        },
        "functionAppName": {
            "type": "string",
            "defaultValue": "myFunctionApp"
        },
        "appServicePlanSku": {
            "type": "object",
            "defaultValue": {
                "name": "Y1",
                "tier": "Dynamic"
            }
        }
    },
    "variables": {
        "randomSuffix": "[uniqueString(resourceGroup().id)]"
    },
    "resources": [
        {
            "type": "Microsoft.Web/serverfarms",
            "apiVersion": "2023-12-01",
            "name": "[concat(parameters('functionAppName'), '-plan-', variables('randomSuffix'))]",
            "location": "[parameters('location')]",
            "sku": "[parameters('appServicePlanSku')]",
            "properties": {
                "computeMode": "Dynamic"
            }
        },
        {
            "type": "Microsoft.Web/sites",
            "apiVersion": "2023-12-01",
            "name": "[concat(parameters('functionAppName'), '-', variables('randomSuffix'))]",
            "location": "[parameters('location')]",
            "kind": "functionapp",
            "dependsOn": [
                "[resourceId('Microsoft.Web/serverfarms', concat(parameters('functionAppName'), '-plan-', variables('randomSuffix')))]"
            ],
            "properties": {
                "enabled": true,
                "serverFarmId": "[resourceId('Microsoft.Web/serverfarms', concat(parameters('functionAppName'), '-plan-', variables('randomSuffix')))]",
                "siteConfig": {
                    "numberOfWorkers": 1,
                    "functionAppScaleLimit": 200,
                    "minimumElasticInstanceCount": 1
                },
                "httpsOnly": true
            }
        },
        {
            "type": "Microsoft.Web/sites/hostNameBindings",
            "apiVersion": "2023-12-01",
            "name": "[concat(parameters('functionAppName'), '-', variables('randomSuffix'), '/', parameters('functionAppName'), '-', variables('randomSuffix'), '.azurewebsites.net')]",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/sites', concat(parameters('functionAppName'), '-', variables('randomSuffix')))]"
            ],
            "properties": {
                "siteName": "[concat(parameters('functionAppName'), '-', variables('randomSuffix'))]",
                "hostNameType": "Verified"
            }
        },
        {
            "type": "Microsoft.Resources/deploymentScripts",
            "apiVersion": "2022-10-01",
            "name": "deployFunctionCode",
            "location": "[parameters('location')]",
            "dependsOn": [
                "[resourceId('Microsoft.Web/sites', concat(parameters('functionAppName'), '-', variables('randomSuffix')))]"
            ],
            "properties": {
                "forceUpdateTag": "1.0",
                "azPowerShellVersion": "5.0",
                "scriptContent": "New-AzStorageBlobCopy -AbsoluteUri \"[parameters('githubReleaseUrl')]\" -DestinationContainer \"function-releases\" -DestinationBlob \"artifact.zip\"; Start-Sleep -Seconds 10; Expand-Archive -Path \"artifact.zip\" -DestinationPath \"C:\\home\\site\\wwwroot\";",
                "timeout": "PT30M",
                "cleanupPreference": "Always"
            }
        }
    ]
}
